VITE_API_BASE_URL=http://localhost:8000/api/v1

# Used only for the Google OAuth redirect handshake (see
# src/lib/supabase-client.ts) — not for any other API call, which all go
# through the backend above. Same values as backend/.env's SUPABASE_URL and
# SUPABASE_ANON_KEY; the anon key is safe client-side by design, unlike the
# service role key.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
