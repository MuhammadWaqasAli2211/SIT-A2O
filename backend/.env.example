# Supabase project
SUPABASE_URL=https://cfffgnynzqmdzcgljuhx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Raw UTF-8 string, NOT base64-decoded (verified against both keys)
SUPABASE_JWT_SECRET=

# TODO: Settings > Database > Connection string > URI (session pooler, port 5432)
DATABASE_URL=

# Gmail API — backend-triggered emails (interview invites, results, onboarding
# links). See docs/security.md for how to obtain these via Google Cloud Console.
GMAIL_SENDER_EMAIL=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# InterviewerAI — Phase 2 AI screening invites (bulk-invite the InterviewerAI
# service, not our own SMTP). Base URL rarely changes; leave it at the default
# unless InterviewerAI gives you a different one.
INTERVIEWER_AI_API_KEY=
INTERVIEWER_AI_BASE_URL=https://interviewerai-production-b311.up.railway.app/api/v1

# Agilytics — post-onboarding workspace provisioning. The secret is a shared
# HMAC key, not a bearer token: it signs every request we send and must never
# reach the frontend. The base URL below is a Vercel *preview* deployment;
# point it at the production host when there is one.
PORTAL_AGILYTICS_SECRET=
AGILYTICS_API_BASE_URL=https://agilytics-preview.vercel.app

# App
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Where emailed links (signup confirmation today) point back to. One origin,
# not a list — see the field's own docstring in app/core/config.py.
FRONTEND_URL=http://localhost:5173
